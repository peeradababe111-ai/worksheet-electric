  // แสดงคำถามข้อปัจจุบัน
  function renderQuestion() {
    if (gameState.answers.length >= gameState.questions.length) {
      finishGame();
      return;
    }

    const idx = gameState.answers.length;
    const totalQ = gameState.questions.length;
    const q = gameState.questions[idx];

    selectedChoice = null;
    selectedType = null;
    stepLocked = false;

    // อัปเดต HUD
    $("hud-player").textContent = `${gameState.student.first} ${gameState.student.last} · ห้อง ${gameState.student.room} (เลขที่ ${gameState.student.number})`;
    const scoreNow = gameState.answers.reduce((sum, a) => sum + (a.matchOk ? 10 : 0) + (a.typeOk ? 10 : 0), 0);
    $("hud-score").textContent = scoreNow;
    $("hud-progress-text").textContent = `ข้อ ${idx + 1} / ${totalQ}`;
    $("hud-progress-fill").style.width = `${((idx + 1) / totalQ) * 100}%`;

    // รูปภาพและชื่อสื่อฝั่งซ้าย
    $("q-badge").textContent = `สื่อชนิดที่ ${idx + 1} จาก ${totalQ}`;
