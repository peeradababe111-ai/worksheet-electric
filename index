    try {
      const saved = JSON.parse(localStorage.getItem(STORAGE.PROGRESS));
      if (
        saved && !saved.isDemo &&
        saved.student.first === student.first &&
        saved.student.last === student.last &&
        saved.student.number === student.number &&
        saved.student.room === student.room &&
        saved.answers.length < saved.questions.length
      ) {
        gameState = saved;
        notify(`กู้คืนความคืบหน้าของ ${student.first} เรียบร้อยแล้ว`);
        renderQuestion();
        return;
      }
    } catch (_) {}

    gameState = {
      isDemo: false,
      student,
      questions: shuffle(mediaBank).map(item => ({
        ...item,
        choices: buildChoices(item)
      })),
      answers: []
    };
    localStorage.setItem(STORAGE.PROGRESS, JSON.stringify(gameState));
    renderQuestion();
  });

  $("demo-btn").addEventListener("click", () => {
