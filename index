  // ตรวจคำตอบข้อปัจจุบัน
  $("submit-q-btn").addEventListener("click", () => {
    if (stepLocked) return;
    stepLocked = true;

    const idx = gameState.answers.length;
    const q = gameState.questions[idx];
    const matchOk = selectedChoice === q.desc;
    const typeOk = selectedType === q.type;

    // เฉลยขั้นที่ 1
    $("choices-list").querySelectorAll(".choice-item").forEach(btn => {
      btn.disabled = true;
      btn.classList.remove("selected");
      const val = btn.dataset.value;
      if (val === q.desc) {
        btn.classList.add("correct");
        btn.innerHTML += `<span>✅</span>`;
      } else if (val === selectedChoice && !matchOk) {
        btn.classList.add("wrong");
        btn.innerHTML += `<span>❌</span>`;
      }
    });

