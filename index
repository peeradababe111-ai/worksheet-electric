    document.querySelectorAll(".type-card-btn").forEach(btn => {
      btn.disabled = true;
      btn.classList.remove("selected");
      const val = btn.dataset.type;
      if (val === q.type) btn.classList.add("correct");
      else if (val === selectedType && !typeOk) btn.classList.add("wrong");
    });

    gameState.answers.push({
      id: q.id,
      name: q.name,
      selectedDesc: selectedChoice,
      correctDesc: q.desc,
      matchOk,
      selectedType,
      correctType: q.type,
      typeOk
    });

    if (!gameState.isDemo) {
      localStorage.setItem(STORAGE.PROGRESS, JSON.stringify(gameState));
