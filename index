        </div>
      `;
      reviewEl.appendChild(li);
    });

    showView("view-result");

    const statusMsg = $("res-sync-msg");
    if (gameState.isDemo) {
      statusMsg.style.color = "var(--gold)";
      statusMsg.textContent = "โหมดทดลองเล่น: ไม่ได้บันทึกคะแนนเข้าสู่ระบบครู";
      return;
    }

    localStorage.removeItem(STORAGE.PROGRESS);

    const record = {
      first_name: gameState.student.first,
      last_name: gameState.student.last,
      student_number: gameState.student.number,
      classroom: gameState.student.room,
      match_score: matchCount * 10,
      type_score: typeCount * 10,
      total_score: totalScore,
      submitted_at: new Date().toLocaleString("th-TH")
    };

    const localScores = JSON.parse(localStorage.getItem(STORAGE.SCORES) || "[]");
    localScores.unshift(record);
    localStorage.setItem(STORAGE.SCORES, JSON.stringify(localScores));

    const url = getSheetUrl();
    if (url) {
      statusMsg.style.color = "var(--gold)";
      statusMsg.textContent = "⏳ กำลังส่งคะแนนเข้า Google Sheets...";
      try {
        const res = await fetch(url, {
          method: "POST",
          body: JSON.stringify({ action: "save_score", score: record })
        });
        const json = await res.json();
        if (json.ok) {
          statusMsg.style.color = "var(--green)";
          statusMsg.textContent = "✅ ส่งคะแนนไปยัง Google Sheets เรียบร้อยแล้ว!";
        } else {
          throw new Error("Save error");
        }
      } catch (_) {
        statusMsg.style.color = "var(--red)";
        statusMsg.textContent = "⚠️ ส่งเข้า Google Sheets ไม่สำเร็จ (บันทึกสำรองในเครื่องแล้ว กรุณาแคปหน้าจอส่งครู)";
      }
    } else {
      statusMsg.style.color = "var(--green)";
      statusMsg.textContent = "💾 บันทึกคะแนนในเครื่องเรียบร้อยแล้ว";
    }
  }

  $("restart-btn").addEventListener("click", () => {
    gameState = null;
    $("start-form").reset();
    checkResumeState();
    showView("view-start");
  });

  // =========================================================================
  // 2. โหมดครู (Teacher Dashboard)
  // =========================================================================
  let inTeacherMode = false;

  $("teacher-toggle-btn").addEventListener("click", () => {
    inTeacherMode = !inTeacherMode;
    if (inTeacherMode) {
      $("teacher-toggle-btn").innerHTML = `<i data-lucide="arrow-left" style="width:17px;height:17px;"></i><span>กลับโหมดนักเรียน</span>`;
      $("sheet-url-input").value = getSheetUrl();
      $("apps-script-preview").textContent = APPS_SCRIPT_CODE;
      showView("view-teacher");
      loadTeacherScores();
      renderQuestionsEditor();
    } else {
      exitTeacherMode();
    }
    lucide.createIcons();
  });

  $("close-teacher-btn").addEventListener("click", exitTeacherMode);

  function exitTeacherMode() {
    inTeacherMode = false;
    $("teacher-toggle-btn").innerHTML = `<i data-lucide="settings-2" style="width:17px;height:17px;"></i><span>โหมดครู</span>`;
    lucide.createIcons();
    if (gameState && gameState.answers.length < gameState.questions.length) {
      showView("view-game");
    } else {
      showView("view-start");
    }
  }

  // สลับแท็บในโหมดครู
  document.querySelectorAll(".tab-btn").forEach(btn => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".tab-btn").forEach(b => b.classList.toggle("active", b === btn));
      const target = btn.dataset.tab;
      document.querySelectorAll(".teacher-tab-pane").forEach(p => {
        p.hidden = p.id !== target;
      });
    });
  });

  // --- แท็บที่ 1: โหลดและแสดงตารางคะแนน ---
  async function loadTeacherScores() {
    const status = $("scores-status");
    const url = getSheetUrl();
    if (url) {
      status.textContent = "⏳ กำลังดึงคะแนนล่าสุดจาก Google Sheets...";
      try {
        const res = await fetch(url);
        const data = await res.json();
        if (data.ok && Array.isArray(data.scores)) {
          allScores = data.scores.reverse();
          status.textContent = `แสดงข้อมูลจาก Google Sheets ทั้งหมด ${allScores.length} รายการ`;
          renderScoresTable();
          return;
        }
      } catch (_) {
        status.textContent = "⚠️ ดึงข้อมูลจาก Google Sheets ไม่สำเร็จ แสดงข้อมูลที่บันทึกในเครื่องแทน";
      }
    }

    allScores = JSON.parse(localStorage.getItem(STORAGE.SCORES) || "[]");
    if (!url) status.textContent = `แสดงข้อมูลที่บันทึกในเครื่องนี้ ${allScores.length} รายการ`;
    renderScoresTable();
  }

  function renderScoresTable() {
    const q = $("search-score-input").value.trim().toLowerCase();
    const sortBy = $("sort-score-select").value;
    const tbody = $("scores-tbody");
    tbody.replaceChildren();

    const filtered = allScores.filter(r =>
      [r.first_name, r.last_name, r.classroom, r.student_number].some(v =>
        String(v || "").toLowerCase().includes(q)
      )
    );

    const collator = new Intl.Collator("th", { numeric: true });
    if (sortBy === "score") {
      filtered.sort((a, b) => (b.total_score || 0) - (a.total_score || 0));
    } else if (sortBy === "room") {
      filtered.sort((a, b) => collator.compare(a.classroom || "", b.classroom || "") || collator.compare(a.student_number || "", b.student_number || ""));
    } else if (sortBy === "number") {
      filtered.sort((a, b) => collator.compare(a.student_number || "", b.student_number || ""));
    }

    if (!filtered.length) {
      tbody.innerHTML = `<tr><td colspan="7" style="text-align:center; padding:24px; color:var(--muted);">ยังไม่มีข้อมูลคะแนนนักเรียน</td></tr>`;
      return;
    }

    filtered.forEach(r => {
      const tr = document.createElement("tr");
      tr.innerHTML = `
        <td style="font-weight:600;">${r.first_name} ${r.last_name}</td>
        <td>${r.student_number}</td>
        <td>${r.classroom}</td>
        <td>${r.match_score}</td>
        <td>${r.type_score}</td>
        <td style="color:var(--gold-bright); font-weight:700;">${r.total_score}</td>
        <td style="color:var(--muted); font-size:13px;">${r.submitted_at}</td>
      `;
      tbody.appendChild(tr);
    });
  }

  $("search-score-input").addEventListener("input", renderScoresTable);
  $("sort-score-select").addEventListener("change", renderScoresTable);
  $("refresh-scores-btn").addEventListener("click", loadTeacherScores);

  $("export-csv-btn").addEventListener("click", () => {
    if (!allScores.length) {
      notify("ยังไม่มีข้อมูลคะแนนสำหรับดาวน์โหลด");
      return;
    }
    const headers = ["ชื่อ", "นามสกุล", "เลขที่", "ห้อง", "คะแนนจับคู่ลักษณะ (200)", "คะแนนจำแนกประเภท (200)", "คะแนนรวม (400)", "เวลาที่ส่ง"];
    const rows = allScores.map(r => [
      `"${r.first_name}"`,
      `"${r.last_name}"`,
      `"${r.student_number}"`,
      `"${r.classroom}"`,
      r.match_score,
      r.type_score,
      r.total_score,
      `"${r.submitted_at}"`
    ].join(","));

    const blob = new Blob(["\uFEFF" + [headers.join(","), ...rows].join("\n")], { type: "text/csv;charset=utf-8;" });
    const a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = `คะแนนวิเคราะห์สื่อ_ม4_${new Date().toISOString().slice(0, 10)}.csv`;
    a.click();
    notify("ดาวน์โหลดไฟล์ Excel (CSV) เรียบร้อยแล้ว");
  });

  // --- แท็บที่ 2: แก้ไขโจทย์ทั้ง 20 ข้อ ---
  function renderQuestionsEditor() {
    const grid = $("questions-editor-grid");
    grid.replaceChildren();

    mediaBank.forEach((item, index) => {
      const card = document.createElement("div");
      card.className = "q-edit-card";
      card.innerHTML = `
        <div style="display:flex; justify-content:space-between; align-items:center;">
          <strong style="color:var(--gold-bright);">ข้อที่ ${index + 1}</strong>
          <span class="pill-tag" style="font-size:11px; padding:2px 9px;">ID #${item.id}</span>
        </div>
        <img id="edit-prev-${index}" class="q-edit-preview" src="${item.imageUrl}" alt="${item.name}">
        <div class="field-group">
          <label>ชื่อสื่อ</label>
          <input id="edit-name-${index}" class="arcade-input" value="${item.name}">
        </div>
        <div class="field-group">
          <label>ลิงก์รูปภาพ (URL)</label>
          <input id="edit-img-${index}" class="arcade-input" value="${item.imageUrl}">
        </div>
        <div class="field-group">
          <label>ลักษณะสำคัญ (เฉลยขั้นที่ 1)</label>
          <input id="edit-desc-${index}" class="arcade-input" value="${item.desc}">
        </div>
        <div class="field-group">
          <label>ประเภทสื่อ (เฉลยขั้นที่ 2)</label>
          <select id="edit-type-${index}" class="arcade-select">
            <option value="สื่อสิ่งพิมพ์" ${item.type === "สื่อสิ่งพิมพ์" ? "selected" : ""}>สื่อสิ่งพิมพ์</option>
            <option value="สื่ออิเล็กทรอนิกส์" ${item.type === "สื่ออิเล็กทรอนิกส์" ? "selected" : ""}>สื่ออิเล็กทรอนิกส์</option>
          </select>
        </div>
      `;
      grid.appendChild(card);

      // อัปเดตพรีวิวภาพสดทันทีเมื่อวาง URL ใหม่
      const imgInput = $(`edit-img-${index}`);
      const prevImg = $(`edit-prev-${index}`);
      prevImg.onerror = () => {
        prevImg.src = "https://placehold.co/600x300/14102b/ffcf75?text=ไม่พบรูปภาพ";
      };
      imgInput.addEventListener("input", () => {
        prevImg.src = imgInput.value.trim();
      });
    });
  }

  $("save-questions-btn").addEventListener("click", async () => {
    const updated = [];
    for (let i = 0; i < 20; i++) {
      const name = $(`edit-name-${i}`).value.trim();
      const imageUrl = $(`edit-img-${i}`).value.trim();
      const desc = $(`edit-desc-${i}`).value.trim();
      const type = $(`edit-type-${i}`).value;

      if (!name || !desc) {
        notify(`กรุณากรอกชื่อสื่อและลักษณะสำคัญในข้อที่ ${i + 1} ให้ครบถ้วน`);
        return;
      }
      updated.push({
        id: mediaBank[i].id,
        name,
        imageUrl: imageUrl || DEFAULT_MEDIA_BANK[i].imageUrl,
        desc,
        type
      });
    }

    mediaBank = updated;
    localStorage.setItem(STORAGE.BANK, JSON.stringify(mediaBank));

    const url = getSheetUrl();
    if (url) {
      notify("⏳ กำลังบันทึกชุดโจทย์ไปยัง Google Sheets...");
      try {
        const res = await fetch(url, {
          method: "POST",
          body: JSON.stringify({ action: "save_config", config: mediaBank })
        });
        const json = await res.json();
        if (json.ok) {
          notify("✅ บันทึกโจทย์ทั้ง 20 ข้อลงเครื่องและ Google Sheets เรียบร้อยแล้ว!");
          return;
        }
      } catch (_) {}
      notify("⚠️ บันทึกลงเครื่องแล้ว แต่ซิงก์ขึ้น Google Sheets ไม่สำเร็จ");
    } else {
      notify("💾 บันทึกโจทย์ทั้ง 20 ข้อลงในเครื่องเรียบร้อยแล้ว");
    }
  });

  $("reset-questions-btn").addEventListener("click", () => {
    mediaBank = structuredClone(DEFAULT_MEDIA_BANK);
    localStorage.setItem(STORAGE.BANK, JSON.stringify(mediaBank));
    renderQuestionsEditor();
    notify("คืนค่าโจทย์และรูปภาพเริ่มต้นทั้ง 20 ข้อแล้ว (กดปุ่มบันทึกเพื่อยืนยันขึ้น Google Sheets)");
  });

  // --- แท็บที่ 3: ตั้งค่า Google Sheets ---
  $("save-sheet-url-btn").addEventListener("click", () => {
    const val = $("sheet-url-input").value.trim();
    if (val && !val.startsWith("https://script.google.com/")) {
      notify("⚠️ ลิงก์ควรขึ้นต้นด้วย https://script.google.com/...");
      return;
    }
    if (val) {
      localStorage.setItem(STORAGE.SHEET_URL, val);
      notify("✅ บันทึกลิงก์ Google Sheets เรียบร้อยแล้ว");
    } else {
      localStorage.removeItem(STORAGE.SHEET_URL);
      notify("ยกเลิกการเชื่อมต่อ Google Sheets แล้ว");
    }
    updateSyncStatus();
    loadTeacherScores();
  });

  $("copy-script-btn").addEventListener("click", () => {
    const temp = document.createElement("textarea");
    temp.value = APPS_SCRIPT_CODE;
    document.body.appendChild(temp);
    temp.select();
    const ok = document.execCommand("copy");
    temp.remove();
    notify(ok ? "📋 คัดลอกโค้ด Apps Script ลงคลิปบอร์ดแล้ว" : "คัดลอกไม่สำเร็จ กรุณากดคัดลอกด้วยตนเอง");
  });

  // เริ่มต้นทำงานเมื่อโหลดหน้าเว็บ
  window.addEventListener("DOMContentLoaded", async () => {
    updateSyncStatus();
    await syncConfigFromSheets();
    checkResumeState();
    lucide.createIcons();
  });
</script>
</body>
</html>