<!doctype html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ภารกิจวิเคราะห์สื่อการอ่าน (ม.4) - 20 ชนิดสื่อ</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    :root {
      --bg-base: #171332;
      --ink: #f7f3ff;
      --muted: #c6bce1;
      --purple: #a879ff;
      --purple-dark: #745da9;
      --gold: #ffcf75;
      --gold-bright: #ffdf8c;
      --green: #4ce5a5;
      --red: #ff8297;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: "Kanit", sans-serif;
      color: var(--ink);
      background:
        radial-gradient(circle at 12% 10%, #5435a5 0, transparent 32%),
        radial-gradient(circle at 90% 22%, #313d9b 0, transparent 36%),
        radial-gradient(circle at 50% 95%, #43276f 0, transparent 46%),
        var(--bg-base);
      background-attachment: fixed;
      overflow-x: hidden;
    }

    /* ลายจุดดาวพื้นหลังสไตล์ Arcade */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      pointer-events: none;
      opacity: 0.24;
      background-image: radial-gradient(#ddc9ff 1.2px, transparent 1.2px);
      background-size: 28px 28px;
      mask-image: linear-gradient(to bottom, black 40%, transparent 95%);
      z-index: 0;
    }

    button, input, select, textarea { font-family: "Kanit", sans-serif; }
    button { cursor: pointer; }
    button:focus-visible, input:focus-visible, select:focus-visible {
      outline: 3px solid #ff9a38;
      outline-offset: 2px;
    }
    [hidden] { display: none !important; }

    .shell {
      max-width: 1120px;
      margin: 0 auto;
      padding: 20px 18px 54px;
      position: relative;
      z-index: 1;
    }

    /* แถบเมนูด้านบน */
    header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      flex-wrap: wrap;
      background: #292050dd;
      border: 1px solid #765db0;
      border-radius: 22px;
      padding: 12px 18px;
      box-shadow: 0 12px 30px #0d092850;
      backdrop-filter: blur(10px);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      font-weight: 700;
      font-size: 18px;
    }

    .brand-icon {
      width: 40px;
      height: 40px;
      border-radius: 13px;
      background: linear-gradient(145deg, #ffbe62, #f16b8e);
      color: #2f1847;
      display: grid;
      place-items: center;
      transform: rotate(-6deg);
      box-shadow: 0 4px 0 #a74478, 0 8px 18px #f1788a55;
      flex-shrink: 0;
    }

    .brand-icon svg { transform: rotate(6deg); }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-left: auto;
      flex-wrap: wrap;
    }

    .pill-tag {
      background: #463475;
      color: #f4dbff;
      border: 1px solid #8d6cc4;
      padding: 6px 14px;
      border-radius: 99px;
      font-size: 13px;
      font-weight: 500;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .sync-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #ffcf75;
    }
    .sync-dot.online { background: var(--green); box-shadow: 0 0 8px var(--green); }

    .btn-teacher {
      background: #463475;
      color: #fff3c8;
      border: 1px solid #a684e0;
      border-radius: 12px;
      padding: 8px 14px;
      font-size: 14px;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      box-shadow: 0 4px 0 #261a4a;
      transition: transform 0.12s, background 0.15s;
    }
    .btn-teacher:hover { background: #584191; transform: translateY(-1px); }
    .btn-teacher:active { transform: translateY(2px); box-shadow: 0 1px 0 #261a4a; }

    /* Views */
    .view { display: none; margin-top: 24px; }
    .view.active { display: block; animation: fadeUp 0.3s ease-out; }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* การ์ดหลักสไตล์ Arcade */
    .arcade-card {
      background: linear-gradient(150deg, #32265f, #241c4b);
      border: 2px solid var(--purple-dark);
      border-radius: 26px;
      padding: 24px;
      box-shadow: 0 9px 0 #171134, 0 19px 34px #09071f88;
    }

    /* ปุ่ม 3D สีเหลืองทอง */
    .btn-gold {
      border: 2px solid #ffe8ac;
      background: linear-gradient(180deg, #ffda78, #ffa34f);
      color: #3b2252;
      border-radius: 16px;
      padding: 13px 26px;
      font-size: 17px;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      box-shadow: 0 7px 0 #af5b45, 0 14px 24px #09071c77;
      transition: transform 0.12s, box-shadow 0.12s;
    }
    .btn-gold:hover:not(:disabled) {
      transform: translateY(-2px);
      box-shadow: 0 9px 0 #af5b45, 0 18px 28px #09071c88;
    }
    .btn-gold:active:not(:disabled) {
      transform: translateY(4px);
      box-shadow: 0 3px 0 #af5b45;
    }
    .btn-gold:disabled {
      opacity: 0.45;
      cursor: not-allowed;
      box-shadow: 0 4px 0 #5b3b4e;
    }

    .btn-secondary {
      border: 1px solid #9c7cd9;
      background: #463475;
      color: #fff3c8;
      border-radius: 15px;
      padding: 13px 22px;
      font-size: 16px;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      box-shadow: 0 6px 0 #231845;
      transition: transform 0.12s;
    }
    .btn-secondary:hover { background: #56408f; transform: translateY(-2px); }
    .btn-secondary:active { transform: translateY(3px); box-shadow: 0 2px 0 #231845; }

    /* =========================================================================
       1. หน้าแรก (Intro View)
    ========================================================================= */
    .intro-stage {
      min-height: 600px;
      border: 2px solid #8a6acf;
      border-radius: 34px;
      background:
        radial-gradient(circle at 50% 30%, #6743b370, transparent 58%),
        linear-gradient(145deg, #292053, #211943);
      box-shadow: 0 20px 0 #120e30, 0 32px 56px #0a082b88;
      padding: 40px 20px;
      position: relative;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
    }

    /* ดาวตกแต่ง ✦ */
    .intro-stage::before, .intro-stage::after {
      content: '✦';
      position: absolute;
      pointer-events: none;
      animation: twinkle 3s infinite ease-in-out alternate;
    }
    .intro-stage::before { top: 10%; left: 22%; font-size: 30px; color: #ffcd75; }
    .intro-stage::after { bottom: 12%; right: 20%; font-size: 24px; color: #88e8ec; animation-delay: 1.2s; }

    @keyframes twinkle {
      from { opacity: 0.45; transform: scale(0.9) rotate(0deg); }
      to { opacity: 1; transform: scale(1.15) rotate(15deg); }
    }

    /* ไอคอนลอยตัว 4 มุม */
    .float-badge {
      position: absolute;
      width: 78px;
      height: 78px;
      border-radius: 22px;
      background: linear-gradient(145deg, #6549a6, #382567);
      border: 2px solid #a98cdd;
      box-shadow: 0 8px 0 #1c1540, 0 16px 28px #09071e99;
      display: grid;
      place-items: center;
      font-size: 38px;
      pointer-events: none;
      z-index: 1;
    }
    .float-1 { left: 5%; top: 14%; transform: rotate(-12deg); }
    .float-2 { right: 5%; top: 16%; transform: rotate(13deg); }
    .float-3 { left: 7%; bottom: 13%; transform: rotate(10deg); }
    .float-4 { right: 7%; bottom: 13%; transform: rotate(-10deg); }

    .intro-inner {
      max-width: 680px;
      width: 100%;
      position: relative;
      z-index: 2;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      background: #493476;
      border: 1px solid #a684e0;
      color: #ffe49b;
      padding: 7px 16px;
      border-radius: 99px;
      font-size: 14px;
      font-weight: 600;
      box-shadow: 0 4px 0 #281b4d;
    }

    .hero-title {
      font-size: clamp(34px, 5.5vw, 58px);
      line-height: 1.16;
      margin: 18px 0 14px;
      text-shadow: 0 4px 0 #402977, 0 10px 25px #0b072b;
    }
    .hero-title span { color: var(--gold); }

    .instruction-card {
      background: #1d163d;
      border: 1px solid #7d63bd;
      border-radius: 18px;
      padding: 15px 18px;
      margin: 0 auto 20px;
      text-align: left;
      font-size: 15px;
      line-height: 1.65;
      color: #e9defa;
    }
    .instruction-card strong { color: var(--gold-bright); }

    .steps-pills {
      display: flex;
      justify-content: center;
      gap: 10px;
      flex-wrap: wrap;
      margin-bottom: 24px;
    }

    .step-pill {
      background: #392b66;
      border: 1px solid #8c70bd;
      padding: 9px 15px;
      border-radius: 14px;
      color: #e9defa;
      font-size: 14px;
      box-shadow: 0 5px 0 #21183e;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .step-pill b {
      display: inline-grid;
      place-items: center;
      background: #ffcb71;
      color: #40265f;
      border-radius: 7px;
      width: 23px;
      height: 23px;
      font-size: 13px;
    }

    .player-form {
      background: #1f1842;
      border: 1px solid #745da9;
      border-radius: 22px;
      padding: 20px;
      margin-bottom: 18px;
      text-align: left;
    }

    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-bottom: 18px;
    }

    .field-group label {
      display: block;
      font-size: 13px;
      color: #ded4f2;
      margin-bottom: 5px;
      font-weight: 500;
    }

    .arcade-input, .arcade-select {
      width: 100%;
      background: #14102b;
      border: 2px solid #8169b6;
      border-radius: 12px;
      padding: 10px 13px;
      color: #fff8e8;
      font-size: 15px;
      transition: border-color 0.15s;
    }
    .arcade-input::placeholder { color: #8c7db0; }
    .arcade-input:focus, .arcade-select:focus { border-color: var(--gold); outline: none; }

    /* =========================================================================
       2. หน้าเล่นเกม (Game View)
    ========================================================================= */
    .hud-grid {
      display: grid;
      grid-template-columns: 1.2fr 0.9fr 1.6fr;
      gap: 14px;
      margin-bottom: 18px;
    }

    .hud-card {
      background: linear-gradient(150deg, #32265f, #241c4b);
      border: 2px solid var(--purple-dark);
      border-radius: 18px;
      padding: 14px 18px;
      box-shadow: 0 7px 0 #171134;
    }

    .hud-label { font-size: 13px; color: var(--muted); display: block; }
    .hud-value { font-size: 21px; font-weight: 700; color: var(--gold-bright); }

    .progress-track {
      height: 12px;
      border-radius: 99px;
      background: #171337;
      border: 1px solid #7d69ad;
      overflow: hidden;
      margin-top: 8px;
    }

    .progress-fill {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, #ffb769, #ffdf7b);
      box-shadow: 0 0 12px #ffca75;
      border-radius: 99px;
      transition: width 0.35s ease;
    }

    .board-grid {
      display: grid;
      grid-template-columns: 1fr 1.18fr;
      gap: 20px;
      align-items: start;
    }

    .panel-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 14px;
    }

    .panel-title {
      font-size: 17px;
      font-weight: 700;
      margin: 0;
      display: flex;
      align-items: center;
      gap: 9px;
      color: #fff3c8;
    }

    .badge-icon {
      width: 30px;
      height: 30px;
      border-radius: 9px;
      background: #694aa4;
      color: #ffe19a;
      display: grid;
      place-items: center;
      box-shadow: 0 3px 0 #352156;
    }

    /* การ์ดรูปภาพและชื่อสื่อฝั่งซ้าย */
    .media-frame {
      background: radial-gradient(circle at 50% 40%, #58439a, #362866);
      border: 2px dashed #be9bf2;
      border-radius: 20px;
      padding: 16px;
      text-align: center;
      box-shadow: inset 0 0 25px #1d143b80;
    }

    .media-img-wrap {
      width: 100%;
      height: 240px;
      border-radius: 14px;
      overflow: hidden;
      background: #1b1438;
      border: 2px solid #8e70c9;
      margin-bottom: 14px;
      position: relative;
    }

    .media-img-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .media-name {
      font-size: clamp(24px, 3.5vw, 32px);
      font-weight: 700;
      color: #fff3c8;
      text-shadow: 0 3px 0 #35235b;
      margin: 0 0 4px;
    }

    /* ตัวเลือกขั้นที่ 1 */
    .choice-stack {
      display: grid;
      gap: 10px;
      margin-bottom: 20px;
    }

    .choice-item {
      width: 100%;
      text-align: left;
      padding: 13px 16px;
      border-radius: 15px;
      border: 2px solid #8a6ec4;
      background: #3b2d70;
      color: #fff8e8;
      font-size: 16px;
      font-weight: 500;
      box-shadow: 0 4px 0 #1b143b;
      transition: transform 0.12s, border-color 0.15s, background 0.15s;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }

    .choice-item:hover:not(:disabled) {
      transform: translateY(-2px);
      border-color: #ffdb84;
      background: #4a398a;
    }

    .choice-item.selected {
      border-color: #ffdc83;
      background: #6c4da3;
      box-shadow: 0 0 0 3px #ffdc8360, 0 4px 0 #2b1d4d;
    }

    .choice-item.correct {
      border-color: var(--green);
      background: #1d5c48;
      box-shadow: 0 0 0 3px #4ce5a555;
    }

    .choice-item.wrong {
      border-color: var(--red);
      background: #692539;
      box-shadow: 0 0 0 3px #ff829755;
    }

    .choice-item:disabled { cursor: default; }

    /* ตัวเลือกขั้นที่ 2 (สื่อสิ่งพิมพ์ / สื่ออิเล็กทรอนิกส์) */
    .type-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-bottom: 20px;
    }

    .type-card-btn {
      padding: 15px 14px;
      border-radius: 16px;
      border: 2px solid #8a6ec4;
      background: #3b2d70;
      color: #fff8e8;
      font-size: 16px;
      font-weight: 600;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      box-shadow: 0 5px 0 #1b143b;
      transition: all 0.15s;
    }

    .type-card-btn:hover:not(:disabled) {
      transform: translateY(-2px);
      border-color: #ffdb84;
    }

    .type-card-btn.selected {
      border-color: #ffdc83;
      background: #6c4da3;
      box-shadow: 0 0 0 3px #ffdc8360, 0 5px 0 #2b1d4d;
    }

    .type-card-btn.correct {
      border-color: var(--green);
      background: #1d5c48;
    }

    .type-card-btn.wrong {
      border-color: var(--red);
      background: #692539;
    }

    /* กล่องเฉลย */
    .feedback-banner {
      margin-top: 16px;
      padding: 14px 16px;
      border-radius: 16px;
      background: #1b153b;
      border: 2px solid #8a6ec4;
      font-size: 14px;
      line-height: 1.65;
    }
    .feedback-banner.all-good { border-color: var(--green); }
    .feedback-banner.partial { border-color: var(--gold); }

    /* =========================================================================
       3. หน้าสรุปผล (Result View)
    ========================================================================= */
    .result-box {
      max-width: 760px;
      margin: 0 auto;
      text-align: center;
    }

    .trophy-badge {
      width: 96px;
      height: 96px;
      border-radius: 28px;
      background: #6650a5;
      border: 2px solid #e3b976;
      box-shadow: 0 8px 0 #35245f;
      display: grid;
      place-items: center;
      font-size: 50px;
      margin: 0 auto 16px;
      transform: rotate(-6deg);
    }

    .result-stats-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin: 20px 0;
    }

    .res-stat {
      background: #3b2d70;
      border: 1px solid #7054a8;
      border-radius: 16px;
      padding: 16px 10px;
    }
    .res-stat strong { display: block; font-size: 28px; color: #ffdc83; }
    .res-stat span { font-size: 13px; color: var(--muted); }

    .review-list {
      list-style: none;
      padding: 0;
      margin: 14px 0 22px;
      display: grid;
      gap: 9px;
      max-height: 360px;
      overflow-y: auto;
      text-align: left;
    }

    .review-list li {
      background: #1d163d;
      border: 1px solid #6b53a6;
      border-radius: 14px;
      padding: 12px 15px;
      font-size: 14px;
    }

    /* =========================================================================
       4. โหมดครู (Teacher Dashboard)
    ========================================================================= */
    .teacher-tabs {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-bottom: 20px;
    }

    .tab-btn {
      padding: 10px 18px;
      border-radius: 13px;
      border: 1px solid #8a6ec4;
      background: #392b66;
      color: #e9defa;
      font-size: 15px;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.15s;
    }

    .tab-btn.active {
      background: linear-gradient(180deg, #ffda78, #ffa34f);
      color: #3b2252;
      border-color: #ffe8ac;
      box-shadow: 0 4px 0 #af5b45;
    }

    .table-wrap { overflow-x: auto; margin-top: 14px; }
    .arcade-table {
      width: 100%;
      border-collapse: collapse;
      min-width: 720px;
      font-size: 14px;
    }
    .arcade-table th, .arcade-table td {
      padding: 12px 10px;
      border-bottom: 1px solid #624e9a;
      text-align: left;
    }
    .arcade-table th { color: #ffdc83; background: #221947; white-space: nowrap; }
    .arcade-table tbody tr:hover { background: #3e2f70; }

    /* การ์ดแก้ไขโจทย์ในโหมดครู */
    .editor-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
      gap: 16px;
      margin-top: 16px;
    }

    .q-edit-card {
      background: #221947;
      border: 1px solid #765db0;
      border-radius: 18px;
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .q-edit-preview {
      width: 100%;
      height: 135px;
      border-radius: 12px;
      object-fit: cover;
      background: #14102b;
      border: 1px solid #624e9a;
    }

    .code-box {
      background: #120e29;
      border: 1px solid #624e9a;
      border-radius: 14px;
      padding: 14px;
      font-family: monospace;
      font-size: 12px;
      color: #a5f3fc;
      max-height: 260px;
      overflow: auto;
      white-space: pre;
      margin-top: 12px;
    }

    /* Toast Notification */
    .toast-box {
      position: fixed;
      bottom: 20px;
      right: 20px;
      z-index: 999;
      display: flex;
      flex-direction: column;
      gap: 8px;
      pointer-events: none;
    }
    .toast-msg {
      background: #292050;
      border: 2px solid var(--gold);
      color: #fff8e8;
      padding: 12px 18px;
      border-radius: 14px;
      font-size: 14px;
      font-weight: 500;
      box-shadow: 0 10px 25px #00000080;
      animation: fadeUp 0.25s ease-out;
    }

    footer {
      text-align: center;
      color: #baaed7;
      font-size: 13px;
      margin-top: 32px;
    }

    @media (max-width: 780px) {
      .hud-grid, .board-grid, .form-grid, .type-grid, .result-stats-row {
        grid-template-columns: 1fr;
      }
      .float-badge { width: 52px; height: 52px; font-size: 26px; opacity: 0.65; }
      .float-1 { top: 4%; left: 3%; }
      .float-2 { top: 4%; right: 3%; }
      .float-3 { bottom: 3%; left: 3%; }
      .float-4 { bottom: 3%; right: 3%; }
      .media-img-wrap { height: 190px; }
    }
  </style>
</head>
<body>

<div class="shell">
  <!-- แถบเมนูด้านบน -->
  <header>
    <div class="brand">
      <div class="brand-icon"><i data-lucide="shapes"></i></div>
      <span>ภารกิจวิเคราะห์สื่อการอ่าน (ม.4)</span>
    </div>
