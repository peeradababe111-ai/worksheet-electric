  // โค้ด Google Apps Script ฉบับสมบูรณ์ (รองรับทั้ง Scores_M4 และ Config_M4)
  const APPS_SCRIPT_CODE = `const SHEET_SCORES = "Scores_M4";
const SHEET_CONFIG = "Config_M4";

function doGet(e) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  initSheets(ss);

  // 1. ดึงชุดโจทย์ล่าสุดของครู
  const configSheet = ss.getSheetByName(SHEET_CONFIG);
  let configData = null;
  if (configSheet.getLastRow() >= 2) {
    const raw = configSheet.getRange(2, 1).getValue();
    try { configData = JSON.parse(raw); } catch (_) {}
  }

  // 2. ดึงผลคะแนนนักเรียนทั้งหมด
  const scoreSheet = ss.getSheetByName(SHEET_SCORES);
  const rows = scoreSheet.getDataRange().getValues();
  const scores = [];
  for (let i = 1; i < rows.length; i++) {
    if (!rows[i][0]) continue;
    scores.push({
      first_name: String(rows[i][0]),
      last_name: String(rows[i][1]),
      student_number: String(rows[i][2]),
      classroom: String(rows[i][3]),
      match_score: Number(rows[i][4]) || 0,
      type_score: Number(rows[i][5]) || 0,
      total_score: Number(rows[i][6]) || 0,
      submitted_at: String(rows[i][7] || "")
    });
  }

  return jsonOut({ ok: true, config: configData, scores: scores });
}

function doPost(e) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  initSheets(ss);

  try {
    const payload = JSON.parse(e.postData.contents);

    if (payload.action === "save_config") {
      const configSheet = ss.getSheetByName(SHEET_CONFIG);
      configSheet.getRange(2, 1).setValue(JSON.stringify(payload.config));
      configSheet.getRange(2, 2).setValue(new Date().toLocaleString("th-TH"));
      return jsonOut({ ok: true });
    }

    if (payload.action === "save_score") {
      const s = payload.score;
      const scoreSheet = ss.getSheetByName(SHEET_SCORES);
      scoreSheet.appendRow([
        s.first_name,
        s.last_name,
        s.student_number,
        s.classroom,
        s.match_score,
        s.type_score,
        s.total_score,
        s.submitted_at
      ]);
      return jsonOut({ ok: true });
    }

    return jsonOut({ ok: false, error: "Invalid action" });
  } catch (err) {
    return jsonOut({ ok: false, error: err.message });
  }
}

function initSheets(ss) {
  let scoreSheet = ss.getSheetByName(SHEET_SCORES);
  if (!scoreSheet) {
    scoreSheet = ss.insertSheet(SHEET_SCORES);
    scoreSheet.appendRow([
      "ชื่อ", "นามสกุล", "เลขที่", "ห้อง",
      "คะแนนจับคู่ลักษณะ (200)", "คะแนนจำแนกประเภท (200)",
      "คะแนนรวม (400)", "เวลาที่ส่ง"
    ]);
  }
  let configSheet = ss.getSheetByName(SHEET_CONFIG);
  if (!configSheet) {
    configSheet = ss.insertSheet(SHEET_CONFIG);
    configSheet.appendRow(["config_json", "updated_at"]);
  }
}

function jsonOut(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj))
    .setMimeType(ContentService.MimeType.JSON);
}`;

  const STORAGE = {
    BANK: "m4_arcade_media_bank_v1",
    PROGRESS: "m4_arcade_progress_v1",
    SCORES: "m4_arcade_scores_v1",
    SHEET_URL: "m4_arcade_sheet_url_v1"
  };

  const $ = id => document.getElementById(id);

  let mediaBank = loadLocalBank();
  let gameState = null;
  let selectedChoice = null;
  let selectedType = null;
  let stepLocked = false;
  let allScores = [];

  // แสดง Toast แทน alert
  function notify(text) {
    const box = $("toast-container");
    const div = document.createElement("div");
    div.className = "toast-msg";
    div.textContent = text;
    box.appendChild(div);
    setTimeout(() => {
      div.style.opacity = "0";
      div.style.transition = "opacity 0.25s";
      setTimeout(() => div.remove(), 260);
    }, 3200);
  }

  function shuffle(list) {
    const arr = [...list];
    for (let i = arr.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [arr[i], arr[j]] = [arr[j], arr[i]];
    }
    return arr;
  }

  function showView(viewId) {
    document.querySelectorAll(".view").forEach(v => v.classList.toggle("active", v.id === viewId));
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  function getSheetUrl() {
    return localStorage.getItem(STORAGE.SHEET_URL) || "";
  }

  function loadLocalBank() {
    try {
      const saved = JSON.parse(localStorage.getItem(STORAGE.BANK));
      if (Array.isArray(saved) && saved.length === 20) return saved;
    } catch (_) {}
    return structuredClone(DEFAULT_MEDIA_BANK);
  }

  function updateSyncStatus() {
    const url = getSheetUrl();
    const dot = $("sync-dot");
    const label = $("sync-label");
    if (url) {
      dot.classList.add("online");
      label.textContent = "เชื่อมต่อ Google Sheets แล้ว";
    } else {
      dot.classList.remove("online");
      label.textContent = "บันทึกในเครื่อง";
    }
  }

  // ซิงก์ชุดโจทย์จาก Google Sheets เมื่อเปิดหน้าเว็บ
  async function syncConfigFromSheets() {
    const url = getSheetUrl();
    if (!url) return;
    try {
      const res = await fetch(url);
      const data = await res.json();
      if (data.ok && Array.isArray(data.config) && data.config.length === 20) {
        mediaBank = data.config;
        localStorage.setItem(STORAGE.BANK, JSON.stringify(mediaBank));
      }
      if (data.ok && Array.isArray(data.scores)) {
        allScores = data.scores.reverse();
      }
    } catch (_) {}
  }

  // ตรวจสอบความคืบหน้าที่เล่นค้างไว้
  function checkResumeState() {
    try {
      const saved = JSON.parse(localStorage.getItem(STORAGE.PROGRESS));
      if (saved && !saved.isDemo && Array.isArray(saved.answers) && saved.answers.length < saved.questions.length) {
        $("resume-box").hidden = false;
        $("resume-text").textContent = `พบข้อมูลค้างไว้ของ ${saved.student.first} ${saved.student.last} (ทำไปแล้ว ${saved.answers.length}/${saved.questions.length} ข้อ)`;
        $("resume-btn").onclick = () => {
          gameState = saved;
          renderQuestion();
        };
      } else {
        $("resume-box").hidden = true;
      }
    } catch (_) {
      $("resume-box").hidden = true;
    }
  }

  function buildChoices(target) {
    const distractors = shuffle(
      mediaBank.filter(m => m.id !== target.id && m.desc !== target.desc)
    ).slice(0, 3).map(m => m.desc);
    return shuffle([target.desc, ...distractors]);
  }

  // เริ่มเกม
  $("start-form").addEventListener("submit", e => {
    e.preventDefault();
    const student = {
      first: $("in-first").value.trim(),
      last: $("in-last").value.trim(),
      number: $("in-number").value.trim(),
      room: $("in-room").value.trim()
